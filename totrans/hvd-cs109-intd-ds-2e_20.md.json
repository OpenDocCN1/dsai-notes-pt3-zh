ble sortable\">\n#> [1] <tbody>\\n<tr>\\n<th>State\\n</th>\\n<th>\\n<a href=\"/wiki/List_of_U.S ...\n```", "```r\ntab <- tab[[1]] |> [html_table](https://rvest.tidyverse.org/reference/html_table.html)()\n[class](https://rdrr.io/r/base/class.html)(tab)\n#> [1] \"tbl_df\"     \"tbl\"        \"data.frame\"\n```", "```r\ntab <- tab |> [setNames](https://rdrr.io/r/stats/setNames.html)([c](https://rdrr.io/r/base/c.html)(\"state\", \"population\", \"total\", \"murder_rate\")) \n[head](https://rdrr.io/r/utils/head.html)(tab)\n#> # A tibble: 6 × 4\n#>   state      population total murder_rate\n#>   <chr>      <chr>      <chr>       <dbl>\n#> 1 Alabama    4,853,875  348           7.2\n#> 2 Alaska     737,709    59            8 \n#> 3 Arizona    6,817,565  309           4.5\n#> 4 Arkansas   2,977,853  181           6.1\n#> 5 California 38,993,940 1,861         4.8\n#> # ℹ 1 more row\n```", "```r\n#> [\n#>   {\n#>     \"name\": \"Miguel\",\n#>     \"student_id\": 1,\n#>     \"exam_1\": 85,\n#>     \"exam_2\": 86\n#>   },\n#>   {\n#>     \"name\": \"Sofia\",\n#>     \"student_id\": 2,\n#>     \"exam_1\": 94,\n#>     \"exam_2\": 93\n#>   },\n#>   {\n#>     \"name\": \"Aya\",\n#>     \"student_id\": 3,\n#>     \"exam_1\": 87,\n#>     \"exam_2\": 88\n#>   },\n#>   {\n#>     \"name\": \"Cheng\",\n#>     \"student_id\": 4,\n#>     \"exam_1\": 90,\n#>     \"exam_2\": 91\n#>   }\n#> ]\n```", "```r\n[library](https://rdrr.io/r/base/library.html)([jsonlite](https://jeroen.r-universe.dev/jsonlite))\nnobel <- [fromJSON](https://jeroen.r-universe.dev/jsonlite/reference/fromJSON.html)(\"http://api.nobelprize.org/v1/prize.json\")\n```", "```r\nnobel$prizes |>\n [filter](https://dplyr.tidyverse.org/reference/filter.html)(category == \"literature\" & year == \"1971\") |> \n [pull](https://dplyr.tidyverse.org/reference/pull.html)(laureates) |>\n [first](https://dplyr.tidyverse.org/reference/nth.html)() |>\n [select](https://dplyr.tidyverse.org/reference/select.html)(id, firstname, surname)\n#>  